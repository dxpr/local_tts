#!/bin/bash

# Pre-commit hook for Drupal module
# Automatically fixes code style issues and blocks commits with errors

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get the module root directory (3 levels up from scripts/git-hooks/)
MODULE_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$MODULE_ROOT"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Filter for PHP-related files
PHP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(php|module|inc|install|test|theme)$' || true)
YML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yml|yaml)$' || true)
MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)

# Exit early if no relevant files
if [ -z "$PHP_FILES" ] && [ -z "$YML_FILES" ] && [ -z "$MD_FILES" ]; then
  echo -e "${GREEN}✓ No PHP/YML/MD files to check${NC}"
  exit 0
fi

# Check if composer dependencies are installed
if [ ! -f "vendor/bin/phpcs" ]; then
  echo -e "${YELLOW}Installing Composer dependencies...${NC}"
  composer install --no-interaction --quiet
fi

PHPCS="vendor/bin/phpcs"
PHPCBF="vendor/bin/phpcbf"
HAS_ERRORS=0

# Function to run PHPCBF (auto-fix)
run_autofix() {
  local files="$1"
  local file_type="$2"

  if [ -z "$files" ]; then
    return 0
  fi

  echo -e "${YELLOW}Auto-fixing $file_type files...${NC}"

  # Run phpcbf on staged files
  if echo "$files" | xargs $PHPCBF \
    --standard=Drupal,DrupalPractice \
    --extensions=php,module,inc,install,test,profile,theme,info,txt,md,yml \
    2>/dev/null || true; then

    # Stage any files that were modified by phpcbf
    for file in $files; do
      if [ -f "$file" ]; then
        git add "$file"
        echo -e "${GREEN}  ✓ Auto-fixed and staged: $file${NC}"
      fi
    done
  fi
}

# Function to check for remaining issues
check_remaining_issues() {
  local files="$1"
  local file_type="$2"

  if [ -z "$files" ]; then
    return 0
  fi

  echo -e "${YELLOW}Checking for remaining issues in $file_type files...${NC}"

  # Run phpcs to check for remaining issues
  if ! echo "$files" | xargs $PHPCS \
    --standard=Drupal,DrupalPractice \
    --extensions=php,module,inc,install,test,profile,theme,info,txt,md,yml \
    --report=full; then

    echo -e "${RED}✗ $file_type files have coding standard violations that cannot be auto-fixed${NC}"
    return 1
  else
    echo -e "${GREEN}✓ $file_type files passed all checks${NC}"
    return 0
  fi
}

# Process PHP files
if [ -n "$PHP_FILES" ]; then
  run_autofix "$PHP_FILES" "PHP"
  if ! check_remaining_issues "$PHP_FILES" "PHP"; then
    HAS_ERRORS=1
  fi
fi

# Process YML files
if [ -n "$YML_FILES" ]; then
  run_autofix "$YML_FILES" "YML"
  if ! check_remaining_issues "$YML_FILES" "YML"; then
    HAS_ERRORS=1
  fi
fi

# Process MD files
if [ -n "$MD_FILES" ]; then
  run_autofix "$MD_FILES" "Markdown"
  if ! check_remaining_issues "$MD_FILES" "Markdown"; then
    HAS_ERRORS=1
  fi
fi

# Final result
if [ $HAS_ERRORS -eq 1 ]; then
  echo ""
  echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  COMMIT BLOCKED: Fix the errors above before committing   ║${NC}"
  echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${YELLOW}Auto-fixed issues have been staged. Please review and commit again.${NC}"
  exit 1
fi

echo ""
echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  ✓ All checks passed! Proceeding with commit...           ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

exit 0

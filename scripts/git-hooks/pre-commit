#!/bin/bash

# Pre-commit hook for AI TTS module
# Runs PHPCS, PHPStan, ESLint, and Stylelint on staged files

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

MODULE_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$MODULE_ROOT"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

PHP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(php|module|inc|install|test|theme)$' || true)
YML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yml|yaml)$' || true)
MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)
JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.js$' || true)
CSS_FILES=$(echo "$STAGED_FILES" | grep -E '\.css$' || true)

if [ -z "$PHP_FILES" ] && [ -z "$YML_FILES" ] && [ -z "$MD_FILES" ] && [ -z "$JS_FILES" ] && [ -z "$CSS_FILES" ]; then
  echo -e "${GREEN}No lintable files staged${NC}"
  exit 0
fi

HAS_ERRORS=0

# --- PHPCS ---
if [ -n "$PHP_FILES" ] || [ -n "$YML_FILES" ] || [ -n "$MD_FILES" ]; then
  if [ ! -f "vendor/bin/phpcs" ]; then
    echo -e "${YELLOW}Installing Composer dependencies...${NC}"
    composer install --no-interaction --quiet
  fi

  ALL_FILES="$PHP_FILES $YML_FILES $MD_FILES"

  echo -e "${YELLOW}Auto-fixing code style...${NC}"
  echo "$ALL_FILES" | xargs vendor/bin/phpcbf \
    --standard=Drupal,DrupalPractice \
    --extensions=php,module,inc,install,test,profile,theme,info,txt,md,yml \
    2>/dev/null || true

  for file in $ALL_FILES; do
    [ -f "$file" ] && git add "$file"
  done

  echo -e "${YELLOW}Checking coding standards...${NC}"
  if ! echo "$ALL_FILES" | xargs vendor/bin/phpcs \
    --standard=Drupal,DrupalPractice \
    --extensions=php,module,inc,install,test,profile,theme,info,txt,md,yml \
    --report=full; then
    echo -e "${RED}PHPCS: violations found${NC}"
    HAS_ERRORS=1
  else
    echo -e "${GREEN}PHPCS: passed${NC}"
  fi
fi

# --- PHPStan ---
if [ -n "$PHP_FILES" ]; then
  if [ -f "vendor/bin/phpstan" ]; then
    echo -e "${YELLOW}Running PHPStan...${NC}"
    if ! vendor/bin/phpstan analyse --no-progress 2>/dev/null; then
      echo -e "${RED}PHPStan: errors found${NC}"
      HAS_ERRORS=1
    else
      echo -e "${GREEN}PHPStan: passed${NC}"
    fi
  fi
fi

# --- ESLint ---
if [ -n "$JS_FILES" ]; then
  if [ ! -d "node_modules" ]; then
    echo -e "${YELLOW}Installing npm dependencies...${NC}"
    npm ci --ignore-scripts --silent 2>/dev/null
  fi

  echo -e "${YELLOW}Running ESLint...${NC}"
  if ! npx eslint $JS_FILES; then
    echo -e "${RED}ESLint: errors found${NC}"
    HAS_ERRORS=1
  else
    echo -e "${GREEN}ESLint: passed${NC}"
  fi
fi

# --- Stylelint ---
if [ -n "$CSS_FILES" ]; then
  if [ ! -d "node_modules" ]; then
    echo -e "${YELLOW}Installing npm dependencies...${NC}"
    npm ci --ignore-scripts --silent 2>/dev/null
  fi

  echo -e "${YELLOW}Running Stylelint...${NC}"
  if ! npx stylelint $CSS_FILES; then
    echo -e "${RED}Stylelint: errors found${NC}"
    HAS_ERRORS=1
  else
    echo -e "${GREEN}Stylelint: passed${NC}"
  fi
fi

# --- Result ---
if [ $HAS_ERRORS -eq 1 ]; then
  echo ""
  echo -e "${RED}COMMIT BLOCKED: fix the errors above${NC}"
  exit 1
fi

echo ""
echo -e "${GREEN}All checks passed${NC}"
exit 0

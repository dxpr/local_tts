#!/bin/bash

# Commit message validation hook
# Ensures commit messages follow conventional commit format

set -e

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Allow commits that already include the co-author footer
if echo "$COMMIT_MSG" | grep -q "Co-Authored-By: Claude"; then
  echo -e "${GREEN}✓ Commit message validated${NC}"
  exit 0
fi

# Check if commit message is empty
if [ -z "$(echo "$COMMIT_MSG" | sed '/^#/d' | sed '/^$/d')" ]; then
  echo -e "${RED}✗ Commit message cannot be empty${NC}"
  exit 1
fi

# Get first line
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n1)

# Skip validation for merge commits
if echo "$FIRST_LINE" | grep -qE "^Merge "; then
  echo -e "${GREEN}✓ Merge commit detected${NC}"
  exit 0
fi

# Skip validation for revert commits
if echo "$FIRST_LINE" | grep -qE "^Revert "; then
  echo -e "${GREEN}✓ Revert commit detected${NC}"
  exit 0
fi

# Validate conventional commit format (optional but recommended)
# Format: type(scope): subject
# Examples: feat: add new feature, fix: resolve bug, docs: update README
if echo "$FIRST_LINE" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .+"; then
  echo -e "${GREEN}✓ Conventional commit format detected${NC}"
elif echo "$FIRST_LINE" | grep -qE "^[A-Z]"; then
  # Allow capitalized subject line (Drupal style)
  echo -e "${GREEN}✓ Standard commit format detected${NC}"
else
  echo -e "${YELLOW}⚠ Commit message recommendation:${NC}"
  echo -e "${YELLOW}  Use conventional commit format: type: subject${NC}"
  echo -e "${YELLOW}  Types: feat, fix, docs, style, refactor, test, chore${NC}"
  echo -e "${YELLOW}  Example: feat: add TTS caching support${NC}"
  # Don't block - just warn
fi

# Check line length (first line should be <= 72 characters)
FIRST_LINE_LENGTH=${#FIRST_LINE}
if [ $FIRST_LINE_LENGTH -gt 72 ]; then
  echo -e "${YELLOW}⚠ First line is $FIRST_LINE_LENGTH characters (recommended: ≤72)${NC}"
  # Don't block - just warn
fi

echo -e "${GREEN}✓ Commit message validated${NC}"
exit 0

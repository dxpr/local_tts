# Deny all direct web access to model and voice data files
# These binary files are read server-side only by the koko executable
# and should never be served via HTTP.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Fallback for Apache 2.2
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

{
  "env": {
    "browser": true
  },
  "globals": {
    "Drupal": "readonly",
    "drupalSettings": "readonly",
    "once": "readonly",
    "jQuery": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "camelcase": "off",
    "consistent-return": "off",
    "eqeqeq": ["error", "smart"],
    "no-console": "error",
    "no-shadow": "error",
    "no-undef": "error",
    "no-unused-vars": ["error", { "args": "none" }],
    "no-use-before-define": ["error", { "functions": false }],
    "no-var": "error",
    "prefer-const": "error",
    "strict": ["error", "function"]
  }
}

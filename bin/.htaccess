# Deny all direct web access to executables
# The koko binary is executed server-side only via PHP exec()
# and should never be served via HTTP.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Fallback for Apache 2.2
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

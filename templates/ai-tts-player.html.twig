{#
/**
 * @file
 * Template for AI TTS player.
 *
 * Available variables:
 * - button_text: The text for the play button.
 * - show_voice_selector: Whether to show the voice selector.
 * - show_speed_control: Whether to show the speed control.
 * - voices: Array of available voices.
 * - default_voice: The default voice to use.
 * - default_speed: The default speech speed.
 */
#}
<div class="ai-tts-player">
  <div class="ai-tts-controls">
    <button id="ai-tts-play-button" class="ai-tts-button" type="button">
      {{ button_text }}
    </button>
    <button id="ai-tts-stop-button" class="ai-tts-button ai-tts-stop" type="button" disabled>
      {{ 'Stop'|t }}
    </button>
  </div>

  {% if show_voice_selector or show_speed_control %}
    <div class="ai-tts-settings">
      {% if show_voice_selector %}
        <div class="ai-tts-voice-selector">
          <label for="ai-tts-voice-select">{{ 'Voice'|t }}:</label>
          <select id="ai-tts-voice-select">
            {% for voice in voices %}
              <option value="{{ voice }}" {% if voice == default_voice %}selected{% endif %}>
                {{ voice }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      {% if show_speed_control %}
        <div class="ai-tts-speed-control">
          <label for="ai-tts-speed-input">{{ 'Speed'|t }}:</label>
          <input
            type="number"
            id="ai-tts-speed-input"
            min="0.5"
            max="2.0"
            step="0.1"
            value="{{ default_speed }}"
          >
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-tts-status" id="ai-tts-status"></div>
  <audio id="ai-tts-audio" style="display: none;"></audio>
</div>

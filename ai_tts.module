<?php

/**
 * @file
 * AI Text-to-Speech module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function ai_tts_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ai_tts':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The AI Text-to-Speech module provides high-quality AI-powered text-to-speech functionality using the Kokoro TTS engine (Rust implementation).') . '</p>';
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<p>' . t('This module requires the Kokoro binary (koko) to be installed on the server. Download from: <a href="@url">@url</a>', [
        '@url' => 'https://github.com/lucasjinreal/Kokoros',
      ]) . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure the module at Administration > Configuration > Media > AI TTS.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_cron().
 */
function ai_tts_cron() {
  $config = \Drupal::config('ai_tts.settings');

  _ai_tts_cleanup_stale_content();

  if ($config->get('cache_size_limit_enabled')) {
    _ai_tts_enforce_size_limit();
  }
}

/**
 * Implements hook_entity_update().
 */
function ai_tts_entity_update(EntityInterface $entity) {
  \Drupal::service('ai_tts.tts_service')->deleteAudioForEntity(
    $entity->getEntityTypeId(),
    $entity->id()
  );
}

/**
 * Implements hook_entity_delete().
 */
function ai_tts_entity_delete(EntityInterface $entity) {
  \Drupal::service('ai_tts.tts_service')->deleteAudioForEntity(
    $entity->getEntityTypeId(),
    $entity->id()
  );
}

/**
 * Clean up audio files where source content has changed or been deleted.
 */
function _ai_tts_cleanup_stale_content() {
  $directory = _ai_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $deleted = 0;
  $records = \Drupal::database()->select('ai_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'entity_type', 'entity_id'])
    ->isNotNull('entity_type')
    ->isNotNull('entity_id')
    ->execute()
    ->fetchAll();

  foreach ($records as $record) {
    $should_delete = FALSE;

    try {
      $entity = \Drupal::entityTypeManager()
        ->getStorage($record->entity_type)
        ->load($record->entity_id);

      if (!$entity) {
        $should_delete = TRUE;
      }
    }
    catch (\Exception $e) {
      $should_delete = TRUE;
    }

    if ($should_delete) {
      $file_path = $directory . '/' . $record->cache_key . '.wav';
      if (file_exists($file_path)) {
        @unlink($file_path);
      }
      \Drupal::database()->delete('ai_tts_cache')
        ->condition('id', $record->id)
        ->execute();
      $deleted++;
    }
  }

  if ($deleted > 0) {
    \Drupal::logger('ai_tts')->info('Deleted @count stale audio files', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Enforce size limit by deleting least recently accessed files.
 */
function _ai_tts_enforce_size_limit() {
  $config = \Drupal::config('ai_tts.settings');
  $max_size = $config->get('cache_max_size') ?: 1073741824;
  $directory = _ai_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $current_size = (int) \Drupal::database()->query('SELECT SUM(file_size) FROM {ai_tts_cache}')->fetchField();

  if ($current_size <= $max_size) {
    return;
  }

  $records = \Drupal::database()->select('ai_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'file_size'])
    ->orderBy('accessed', 'ASC')
    ->execute()
    ->fetchAll();

  $bytes_freed = 0;
  $deleted = 0;

  foreach ($records as $record) {
    if ($current_size - $bytes_freed <= $max_size) {
      break;
    }

    $file_path = $directory . '/' . $record->cache_key . '.wav';
    if (file_exists($file_path)) {
      @unlink($file_path);
    }

    \Drupal::database()->delete('ai_tts_cache')
      ->condition('id', $record->id)
      ->execute();

    $bytes_freed += $record->file_size;
    $deleted++;
  }

  if ($deleted > 0) {
    \Drupal::logger('ai_tts')->info('Deleted @count files (@size freed)', [
      '@count' => $deleted,
      '@size' => format_size($bytes_freed),
    ]);
  }
}

/**
 * Get the real path to the audio cache directory.
 *
 * @return string|null
 *   Real filesystem path to the audio directory, or NULL if not accessible.
 */
function _ai_tts_get_audio_directory() {
  $config = \Drupal::config('ai_tts.settings');
  $audio_dir = $config->get('audio_directory') ?: 'public://ai-tts';
  $file_system = \Drupal::service('file_system');
  $directory = $file_system->realpath($audio_dir);

  if (!$directory || !is_dir($directory)) {
    return NULL;
  }

  return $directory;
}

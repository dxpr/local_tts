<?php

/**
 * @file
 * AI Text-to-Speech module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function ai_tts_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ai_tts':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The AI Text-to-Speech module provides high-quality AI-powered text-to-speech functionality using the Kokoro TTS engine (Rust implementation).') . '</p>';
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<p>' . t('This module requires the Kokoro binary (koko) to be installed on the server. Download from: <a href="@url">@url</a>', [
        '@url' => 'https://github.com/lucasjinreal/Kokoros',
      ]) . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure the module at Administration > Configuration > Media > AI TTS.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_cron().
 */
function ai_tts_cron() {
  $config = \Drupal::config('ai_tts.settings');

  _ai_tts_cleanup_stale_content();

  if ($config->get('cache_size_limit_enabled')) {
    _ai_tts_enforce_size_limit();
  }
}

/**
 * Implements hook_entity_update().
 *
 * Smart invalidation: Only delete audio if text content actually changed.
 * Compares text hash to avoid unnecessary regeneration.
 */
function ai_tts_entity_update(EntityInterface $entity) {
  // Check if any text fields changed by comparing to original.
  if (!empty($entity->original) && !_ai_tts_text_content_changed($entity, $entity->original)) {
    // Content unchanged - keep cached audio files.
    return;
  }

  // Content changed - invalidate all cached audio for this entity.
  \Drupal::service('ai_tts.tts_service')->deleteAudioForEntity(
    $entity->getEntityTypeId(),
    $entity->id()
  );
}

/**
 * Implements hook_entity_delete().
 */
function ai_tts_entity_delete(EntityInterface $entity) {
  \Drupal::service('ai_tts.tts_service')->deleteAudioForEntity(
    $entity->getEntityTypeId(),
    $entity->id()
  );
}

/**
 * Check if text content changed between entity versions.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The updated entity.
 * @param \Drupal\Core\Entity\EntityInterface $original
 *   The original entity.
 *
 * @return bool
 *   TRUE if text content changed, FALSE otherwise.
 */
function _ai_tts_text_content_changed($entity, $original) {
  // Only check FieldableEntity types.
  if (!($entity instanceof FieldableEntityInterface)) {
    return TRUE;
  }

  $text_field_types = [
    'string',
    'string_long',
    'text',
    'text_long',
    'text_with_summary',
  ];

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    // Only check text fields.
    if (!in_array($field_definition->getType(), $text_field_types, TRUE)) {
      continue;
    }

    // Skip if field doesn't exist on original.
    if (!$original->hasField($field_name)) {
      continue;
    }

    // Compare field values.
    $current_value = $entity->get($field_name)->value;
    $original_value = $original->get($field_name)->value;

    if ($current_value !== $original_value) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Register "AI TTS Player" extra field for configured entity bundles.
 * Follows Drupal core pattern from comment and node modules.
 *
 * @see comment_entity_extra_field_info()
 * @see node_entity_extra_field_info()
 */
function ai_tts_entity_extra_field_info() {
  $extra = [];

  $config = \Drupal::config('ai_tts.settings');
  $enabled_bundles = $config->get('extra_field_enabled_bundles') ?? [];

  // Register extra field for each configured bundle.
  foreach ($enabled_bundles as $bundle_config) {
    $entity_type = $bundle_config['entity_type'] ?? NULL;
    $bundle = $bundle_config['bundle'] ?? NULL;

    if ($entity_type && $bundle) {
      $extra[$entity_type][$bundle]['display']['ai_tts_player'] = [
        'label' => t('AI TTS Player'),
        'description' => t('Text-to-speech audio player for this content'),
        'weight' => 100,
        'visible' => TRUE,
      ];
    }
  }

  return $extra;
}

/**
 * Implements hook_entity_view().
 *
 * Render the AI TTS player extra field when enabled in display configuration.
 * Uses lazy builder pattern for performance.
 *
 * @see \Drupal\comment\CommentViewBuilder::buildComponents()
 * @see \Drupal\content_moderation\EntityOperations::entityView()
 */
function ai_tts_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Check if the extra field component is configured for this display.
  if (!$display->getComponent('ai_tts_player')) {
    return;
  }

  // Don't render in preview mode.
  if (isset($entity->in_preview) && $entity->in_preview) {
    return;
  }

  // Get entity info.
  $entity_type_id = $entity->getEntityTypeId();
  $entity_id = $entity->id();
  $langcode = $entity->language()->getId();

  // Use lazy builder for deferred rendering (performance optimization).
  // This allows the player to be rendered only when actually needed,
  // and enables proper caching of the player component separately
  // from the rest of the entity.
  $build['ai_tts_player'] = [
    '#lazy_builder' => [
      'ai_tts.lazy_builders:renderPlayer',
      [
        $entity_type_id,
        $entity_id,
        $view_mode,
        $langcode,
        !empty($entity->in_preview),
      ],
    ],
    '#create_placeholder' => TRUE,
  ];
}

/**
 * Clean up audio files where source content has changed or been deleted.
 */
function _ai_tts_cleanup_stale_content() {
  $directory = _ai_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $deleted = 0;
  $records = \Drupal::database()->select('ai_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'entity_type', 'entity_id'])
    ->isNotNull('entity_type')
    ->isNotNull('entity_id')
    ->execute()
    ->fetchAll();

  foreach ($records as $record) {
    $should_delete = FALSE;

    try {
      $entity = \Drupal::entityTypeManager()
        ->getStorage($record->entity_type)
        ->load($record->entity_id);

      if (!$entity) {
        $should_delete = TRUE;
      }
    }
    catch (\Exception $e) {
      $should_delete = TRUE;
    }

    if ($should_delete) {
      $file_path = $directory . '/' . $record->cache_key . '.wav';
      if (file_exists($file_path)) {
        @unlink($file_path);
      }
      \Drupal::database()->delete('ai_tts_cache')
        ->condition('id', $record->id)
        ->execute();
      $deleted++;
    }
  }

  if ($deleted > 0) {
    \Drupal::logger('ai_tts')->info('Deleted @count stale audio files', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Enforce size limit by deleting least recently accessed files.
 */
function _ai_tts_enforce_size_limit() {
  $config = \Drupal::config('ai_tts.settings');
  $max_size = $config->get('cache_max_size') ?: 1073741824;
  $directory = _ai_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $current_size = (int) \Drupal::database()->query('SELECT SUM(file_size) FROM {ai_tts_cache}')->fetchField();

  if ($current_size <= $max_size) {
    return;
  }

  $records = \Drupal::database()->select('ai_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'file_size'])
    ->orderBy('accessed', 'ASC')
    ->execute()
    ->fetchAll();

  $bytes_freed = 0;
  $deleted = 0;

  foreach ($records as $record) {
    if ($current_size - $bytes_freed <= $max_size) {
      break;
    }

    $file_path = $directory . '/' . $record->cache_key . '.wav';
    if (file_exists($file_path)) {
      @unlink($file_path);
    }

    \Drupal::database()->delete('ai_tts_cache')
      ->condition('id', $record->id)
      ->execute();

    $bytes_freed += $record->file_size;
    $deleted++;
  }

  if ($deleted > 0) {
    \Drupal::logger('ai_tts')->info('Deleted @count files (@size freed)', [
      '@count' => $deleted,
      '@size' => format_size($bytes_freed),
    ]);
  }
}

/**
 * Get the real path to the audio cache directory.
 *
 * @return string|null
 *   Real filesystem path to the audio directory, or NULL if not accessible.
 */
function _ai_tts_get_audio_directory() {
  $config = \Drupal::config('ai_tts.settings');
  $audio_dir = $config->get('audio_directory') ?: 'public://ai-tts';
  $file_system = \Drupal::service('file_system');
  $directory = $file_system->realpath($audio_dir);

  if (!$directory || !is_dir($directory)) {
    return NULL;
  }

  return $directory;
}

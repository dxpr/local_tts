<?php

/**
 * @file
 * Install, update and uninstall functions for the AI TTS module.
 */

use Drupal\Core\File\FileSystemInterface;

/**
 * Implements hook_schema().
 */
function ai_tts_schema() {
  $schema['ai_tts_cache'] = [
    'description' => 'Tracks cached TTS audio files',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'cache_key' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'language' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => 'en',
      ],
      'text_hash' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'voice' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'speed' => [
        'type' => 'float',
        'not null' => TRUE,
        'default' => 1.0,
      ],
      'file_size' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'accessed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'cache_key' => ['cache_key'],
    ],
    'indexes' => [
      'entity' => ['entity_type', 'entity_id'],
      'accessed' => ['accessed'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 */
function ai_tts_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('ai_tts.settings');
    $file_system = \Drupal::service('file_system');

    // Check 1: Bundled Files (Binary + Model Files).
    $module_path = \Drupal::service('extension.list.module')->getPath('ai_tts');
    $binary_path = DRUPAL_ROOT . '/' . $module_path . '/bin/koko';
    $model_path = DRUPAL_ROOT . '/' . $module_path . '/data/kokoro-v1.0.onnx';
    $data_path = DRUPAL_ROOT . '/' . $module_path . '/data/voices-v1.0.bin';

    $issues = [];
    $details = [];

    // Binary checks.
    if (!file_exists($binary_path)) {
      $issues[] = t('Binary not found');
    }
    elseif (!is_executable($binary_path)) {
      $issues[] = t('Binary not executable. Run: <code>chmod +x @path</code>', ['@path' => $binary_path]);
    }
    else {
      $binary_size = filesize($binary_path);
      $details[] = t('Binary: @size', ['@size' => format_size($binary_size)]);
    }

    // Model file checks.
    if (!file_exists($model_path)) {
      $issues[] = t('Model file not found');
    }
    else {
      $model_size = filesize($model_path);
      $details[] = t('Model: @size', ['@size' => format_size($model_size)]);
    }

    // Data file checks.
    if (!file_exists($data_path)) {
      $issues[] = t('Voice data not found');
    }
    else {
      $data_size = filesize($data_path);
      $details[] = t('Voice data: @size', ['@size' => format_size($data_size)]);
    }

    // Create single requirement entry.
    if (!empty($issues)) {
      $requirements['ai_tts_files'] = [
        'title' => t('AI TTS bundled files'),
        'value' => t('Missing'),
        'description' => implode(', ', $issues) . '. ' .
        t('Run: <code>cd @module && composer run download-files</code>', [
          '@module' => $module_path,
        ]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    else {
      $requirements['ai_tts_files'] = [
        'title' => t('AI TTS bundled files'),
        'value' => t('Installed (@details)', [
          '@details' => implode(', ', $details),
        ]),
        'severity' => REQUIREMENT_OK,
      ];
    }

    // Check 2: .htaccess Protection (E2E Security Test).
    // This performs actual HTTP HEAD requests to verify files are not
    // accessible.
    $security_issues = [];

    // Test if files are accessible via HTTP (they shouldn't be).
    $base_url = $GLOBALS['base_url'];
    $test_paths = [
      'bin/koko' => 'Binary file',
      'data/kokoro-v1.0.onnx' => 'Model file',
      'data/voices-v1.0.bin' => 'Voice data file',
    ];

    foreach ($test_paths as $path => $label) {
      $url = $base_url . '/' . $module_path . '/' . $path;
      $status_code = _ai_tts_check_url_access($url);

      // Only flag if file is accessible (HTTP 200).
      // NULL (403, 404, connection refused, etc.) is expected and safe.
      if ($status_code === 200) {
        $security_issues[] = t('@label is accessible via HTTP at @url', [
          '@label' => $label,
          '@url' => $url,
        ]);
      }
    }

    if (!empty($security_issues)) {
      $htaccess_desc = t('Security issue:') . ' ' .
        implode(' ', $security_issues) . ' ' .
        t('The .htaccess files in bin/ and data/ directories should prevent web access. Check your Apache configuration and ensure mod_rewrite is enabled.');

      $requirements['ai_tts_security_htaccess'] = [
        'title' => t('AI TTS file protection'),
        'value' => t('Files exposed'),
        'description' => $htaccess_desc,
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    else {
      $htaccess_ok = t('Binary and data files are properly protected by .htaccess (not accessible via HTTP).');

      $requirements['ai_tts_security_htaccess'] = [
        'title' => t('AI TTS file protection'),
        'value' => t('Protected'),
        'description' => $htaccess_ok,
        'severity' => REQUIREMENT_OK,
      ];
    }

    // Check 3: Audio Cache Directory Status.
    $audio_directory = $config->get('audio_directory') ?: 'public://ai-tts';
    $real_path = $file_system->realpath($audio_directory);

    if (!$real_path) {
      // Directory doesn't exist - try to create it.
      if ($file_system->prepareDirectory($audio_directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS)) {
        $requirements['ai_tts_cache_dir'] = [
          'title' => t('AI TTS cache directory'),
          'value' => t('Writable'),
        ];
      }
      else {
        $requirements['ai_tts_cache_dir'] = [
          'title' => t('AI TTS cache directory'),
          'value' => t('Not writable'),
          'description' => t('Failed to create directory. Check web server permissions.'),
          'severity' => REQUIREMENT_ERROR,
        ];
      }
    }
    elseif (!is_writable($real_path)) {
      $requirements['ai_tts_cache_dir'] = [
        'title' => t('AI TTS cache directory'),
        'value' => t('Not writable'),
        'description' => t('Directory exists but is not writable. Run: <code>chmod 755 @path</code>', [
          '@path' => $real_path,
        ]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    else {
      $requirements['ai_tts_cache_dir'] = [
        'title' => t('AI TTS cache directory'),
        'value' => t('Writable'),
      ];
    }

    // Check 3: Audio Cache Size.
    if ($real_path && is_dir($real_path)) {
      $cache_size = _ai_tts_get_directory_size($real_path);
      $file_count = _ai_tts_count_files($real_path);

      if ($file_count === 0) {
        $requirements['ai_tts_cache_size'] = [
          'title' => t('AI TTS cache size'),
          'value' => t('Empty'),
        ];
      }
      else {
        $size_formatted = format_size($cache_size);
        $max_size = $config->get('cache_max_size') ?: 1073741824;
        $percent_used = ($cache_size / $max_size) * 100;

        $requirements['ai_tts_cache_size'] = [
          'title' => t('AI TTS cache size'),
          'value' => t('@size (@percent% of @limit)', [
            '@size' => $size_formatted,
            '@percent' => round($percent_used),
            '@limit' => format_size($max_size),
          ]),
        ];

        // Warn if over 80% of limit.
        if ($percent_used > 80) {
          $requirements['ai_tts_cache_size']['severity'] = REQUIREMENT_WARNING;
          $requirements['ai_tts_cache_size']['description'] = t('Cache is nearly full. Consider running <code>drush ai-tts:cache-clear</code>');
        }
      }
    }
    else {
      $requirements['ai_tts_cache_size'] = [
        'title' => t('AI TTS cache size'),
        'value' => t('Unknown'),
        'description' => t('Cache directory not accessible.'),
        'severity' => REQUIREMENT_WARNING,
      ];
    }

    // Check 4: Security Configuration.
    $max_text_length = $config->get('max_text_length') ?? 1000000;
    $generation_timeout = $config->get('generation_timeout') ?? 900;
    $rate_limit_enabled = $config->get('rate_limit_enabled') ?? TRUE;

    $security_warnings = [];

    // Check if text length limit is reasonable.
    if ($max_text_length === 0) {
      $security_warnings[] = t('No text length limit - potential for resource abuse');
    }
    elseif ($max_text_length > 5000000) {
      $security_warnings[] = t('Very high text limit (@length chars / ~@words words) - may impact performance', [
        '@length' => number_format($max_text_length),
        '@words' => number_format(round($max_text_length / 5)),
      ]);
    }

    // Check if rate limiting is enabled.
    if (!$rate_limit_enabled) {
      $security_warnings[] = t('Rate limiting disabled - unlimited requests allowed');
    }

    // Check generation timeout.
    if ($generation_timeout > 1800) {
      $security_warnings[] = t('Very high timeout (@timeout sec / @minutes min) - may tie up resources', [
        '@timeout' => $generation_timeout,
        '@minutes' => round($generation_timeout / 60),
      ]);
    }

    if (empty($security_warnings)) {
      $requirements['ai_tts_security'] = [
        'title' => t('AI TTS security'),
        'value' => t('Configured'),
      ];
    }
    else {
      $requirements['ai_tts_security'] = [
        'title' => t('AI TTS security'),
        'value' => t('Review recommended'),
        'description' => implode(' ', $security_warnings),
        'severity' => REQUIREMENT_WARNING,
      ];
    }

    // Check 5: Server Load.
    $max_server_load = $config->get('max_server_load') ?? 2;
    if ($max_server_load > 0 && function_exists('sys_getloadavg')) {
      $load = sys_getloadavg();
      if ($load !== FALSE && isset($load[0])) {
        $current_load = (float) $load[0];
        if ($current_load > $max_server_load) {
          $requirements['ai_tts_server_load'] = [
            'title' => t('AI TTS server load'),
            'value' => t('@current (threshold: @max)', [
              '@current' => number_format($current_load, 2),
              '@max' => number_format($max_server_load, 2),
            ]),
            'description' => t('Server load exceeds threshold. TTS generation is currently disabled.'),
            'severity' => REQUIREMENT_WARNING,
          ];
        }
      }
    }

  }

  return $requirements;
}

/**
 * Check URL accessibility via HTTP HEAD request.
 *
 * @param string $url
 *   The URL to check.
 *
 * @return int|null
 *   The HTTP status code, or NULL if request failed.
 */
function _ai_tts_check_url_access($url) {
  try {
    $client = \Drupal::httpClient();

    // Use HEAD request to check without downloading the file.
    $response = $client->request('HEAD', $url, [
      'http_errors' => FALSE,
      'timeout' => 5,
      'allow_redirects' => FALSE,
    ]);

    return $response->getStatusCode();
  }
  catch (\Exception $e) {
    // If request fails (e.g., 403, 404), return NULL.
    // We only care if it returns 200 (file accessible).
    return NULL;
  }
}

/**
 * Calculate the total size of a directory recursively.
 *
 * @param string $path
 *   The directory path.
 *
 * @return int
 *   The total size in bytes.
 */
function _ai_tts_get_directory_size($path) {
  $size = 0;

  if (is_dir($path)) {
    $files = new RecursiveIteratorIterator(
      new RecursiveDirectoryIterator($path, RecursiveDirectoryIterator::SKIP_DOTS),
      RecursiveIteratorIterator::LEAVES_ONLY
    );

    foreach ($files as $file) {
      if ($file->isFile()) {
        $size += $file->getSize();
      }
    }
  }

  return $size;
}

/**
 * Count the number of files in a directory.
 *
 * @param string $path
 *   The directory path.
 *
 * @return int
 *   The number of files.
 */
function _ai_tts_count_files($path) {
  $count = 0;

  if (is_dir($path)) {
    $files = new RecursiveIteratorIterator(
      new RecursiveDirectoryIterator($path, RecursiveDirectoryIterator::SKIP_DOTS),
      RecursiveIteratorIterator::LEAVES_ONLY
    );

    foreach ($files as $file) {
      if ($file->isFile() && $file->getExtension() === 'wav') {
        $count++;
      }
    }
  }

  return $count;
}

/**
 * Implements hook_uninstall().
 */
function ai_tts_uninstall() {
  $config = \Drupal::config('ai_tts.settings');
  $audio_directory = $config->get('audio_directory') ?: 'public://ai-tts';

  try {
    \Drupal::service('file_system')->deleteRecursive($audio_directory);
    \Drupal::messenger()->addStatus(t('AI TTS audio cache has been deleted.'));
  }
  catch (\Exception $e) {
    \Drupal::logger('ai_tts')->error('Failed to delete audio cache during uninstall: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

<?php

/**
 * @file
 * Local Text-to-Speech module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\StringTranslation\ByteSizeMarkup;
use Drupal\local_tts\TtsPlayerBuilder;

/**
 * Implements hook_help().
 */
function local_tts_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.local_tts':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Local Text-to-Speech module adds audio players to your content that read text aloud. It uses the Kokoro text-to-speech engine to create high-quality, natural-sounding speech in multiple languages, entirely on your own server.') . '</p>';
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<p>' . t('You need to install the Kokoro binary (koko) on your server. <a href="@url">Download and installation instructions</a>', [
        '@url' => 'https://github.com/lucasjinreal/Kokoros',
      ]) . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure the module at Administration &gt; Configuration &gt; Media &gt; Local Text-to-Speech.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function local_tts_entity_extra_field_info() {
  $extra = [];

  $entity_types = \Drupal::entityTypeManager()->getDefinitions();
  $bundle_info = \Drupal::service('entity_type.bundle.info');

  foreach ($entity_types as $entity_type_id => $entity_type) {
    if (!$entity_type->entityClassImplements(FieldableEntityInterface::class)) {
      continue;
    }
    if (!$entity_type->hasViewBuilderClass()) {
      continue;
    }

    foreach (array_keys($bundle_info->getBundleInfo($entity_type_id)) as $bundle) {
      $extra[$entity_type_id][$bundle]['display']['local_tts_player'] = [
        'label' => t('TTS Player'),
        'description' => t('Audio player that reads this content aloud.'),
        'weight' => 100,
        'visible' => FALSE,
      ];
    }
  }

  return $extra;
}

/**
 * Implements hook_entity_view().
 */
function local_tts_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if (!$display->getComponent('local_tts_player')) {
    return;
  }
  if (!($entity instanceof FieldableEntityInterface)) {
    return;
  }

  $build['local_tts_player'] = [
    '#create_placeholder' => TRUE,
    '#lazy_builder' => [
      'local_tts.player_builder:buildPlayerLazy',
      [
        $entity->getEntityTypeId(),
        (string) $entity->id(),
        json_encode([
          'show_voice_selector' => TRUE,
          'show_speed_control' => TRUE,
          'show_volume_control' => TRUE,
          'fields' => [],
          'wrapper_classes' => '',
        ]),
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 */
function local_tts_cron() {
  $config = \Drupal::config('local_tts.settings');

  _local_tts_cleanup_stale_content();

  if ($config->get('cache_size_limit_enabled')) {
    _local_tts_enforce_size_limit();
  }

  _local_tts_cleanup_orphan_files();
}

/**
 * Implements hook_entity_update().
 *
 * Smart invalidation: Only delete audio if text content actually changed.
 * Compares text hash to avoid unnecessary regeneration.
 */
function local_tts_entity_update(EntityInterface $entity) {
  // Check if any text fields changed by comparing to original.
  if (!empty($entity->original) && !_local_tts_text_content_changed($entity, $entity->original)) {
    return;
  }

  // Invalidate only the changed translation's cached audio.
  $tts_service = \Drupal::service('local_tts.tts_service');
  $langcode = $entity->language()->getId();
  $tts_service->deleteAudioForEntityTranslation(
    $entity->getEntityTypeId(),
    $entity->id(),
    $langcode
  );

  _local_tts_auto_generate($entity);
}

/**
 * Implements hook_entity_insert().
 */
function local_tts_entity_insert(EntityInterface $entity) {
  _local_tts_auto_generate($entity);
}

/**
 * Queue a TTS generation job when auto-generate is enabled.
 */
function _local_tts_auto_generate(EntityInterface $entity) {
  $config = \Drupal::config('local_tts.settings');
  if (!$config->get('auto_generate')) {
    return;
  }
  if (!($entity instanceof FieldableEntityInterface)) {
    return;
  }
  if (!_local_tts_bundle_allowed($entity->getEntityTypeId(), $entity->bundle())) {
    return;
  }

  $langcode = $entity->language()->getId();
  $tts_service = \Drupal::service('local_tts.tts_service');
  $voices = $tts_service->getAvailableVoices($langcode);
  if (empty($voices)) {
    return;
  }

  $default_voices = $config->get('default_voices') ?? [];
  $voice = $default_voices[$langcode] ?? array_key_first($voices);
  $speed = $config->get('default_speed') ?: '1';

  /** @var \Drupal\Core\Queue\QueueFactory $queue_factory */
  $queue_factory = \Drupal::service('queue');
  $queue = $queue_factory->get('local_tts_generate');
  $queue->createItem([
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'voice' => $voice,
    'speed' => $speed,
    'language' => $langcode,
    'fields' => [],
  ]);
}

/**
 * Implements hook_entity_delete().
 */
function local_tts_entity_delete(EntityInterface $entity) {
  \Drupal::service('local_tts.tts_service')->deleteAudioForEntity(
    $entity->getEntityTypeId(),
    $entity->id()
  );
}

/**
 * Check if text content changed between entity versions.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The updated entity.
 * @param \Drupal\Core\Entity\EntityInterface $original
 *   The original entity.
 *
 * @return bool
 *   TRUE if text content changed, FALSE otherwise.
 */
function _local_tts_text_content_changed($entity, $original) {
  if (!($entity instanceof FieldableEntityInterface) || !($original instanceof FieldableEntityInterface)) {
    return TRUE;
  }

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if (!in_array($field_definition->getType(), TtsPlayerBuilder::ALLOWED_FIELD_TYPES, TRUE)) {
      continue;
    }

    if (!$original->hasField($field_name)) {
      continue;
    }

    $current_value = $entity->get($field_name)->getString();
    $original_value = $original->get($field_name)->getString();

    if ($current_value !== $original_value) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Clean up audio files where source content has changed or been deleted.
 */
function _local_tts_cleanup_stale_content() {
  $directory = _local_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $deleted = 0;
  $records = \Drupal::database()->select('local_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'entity_type', 'entity_id'])
    ->isNotNull('entity_type')
    ->isNotNull('entity_id')
    ->execute()
    ->fetchAll();

  // Group records by entity type for batch loading.
  $grouped = [];
  foreach ($records as $record) {
    $grouped[$record->entity_type][$record->entity_id][] = $record;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $stale_records = [];

  foreach ($grouped as $entity_type => $id_records) {
    try {
      $storage = $entity_type_manager->getStorage($entity_type);
      $ids = array_keys($id_records);
      $loaded = $storage->loadMultiple($ids);

      foreach ($ids as $id) {
        if (!isset($loaded[$id])) {
          foreach ($id_records[$id] as $record) {
            $stale_records[] = $record;
          }
        }
      }
    }
    catch (\Exception $e) {
      // Storage unavailable; mark all records for this type as stale.
      foreach ($id_records as $entity_records) {
        foreach ($entity_records as $record) {
          $stale_records[] = $record;
        }
      }
    }
  }

  foreach ($stale_records as $record) {
    $file_path = $directory . '/' . $record->cache_key . '.ogg';
    if (file_exists($file_path)) {
      @unlink($file_path);
    }
    \Drupal::database()->delete('local_tts_cache')
      ->condition('id', $record->id)
      ->execute();
    $deleted++;
  }

  if ($deleted > 0) {
    \Drupal::logger('local_tts')->info('Deleted @count stale audio files', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Enforce size limit by deleting least recently accessed files.
 */
function _local_tts_enforce_size_limit() {
  $config = \Drupal::config('local_tts.settings');
  $max_size = $config->get('cache_max_size') ?: 1073741824;
  $directory = _local_tts_get_audio_directory();

  if (!$directory) {
    return;
  }

  $current_size = (int) \Drupal::database()->query('SELECT SUM(file_size) FROM {local_tts_cache}')->fetchField();

  if ($current_size <= $max_size) {
    return;
  }

  $records = \Drupal::database()->select('local_tts_cache', 'a')
    ->fields('a', ['id', 'cache_key', 'file_size'])
    ->orderBy('accessed', 'ASC')
    ->execute()
    ->fetchAll();

  $bytes_freed = 0;
  $deleted = 0;

  foreach ($records as $record) {
    if ($current_size - $bytes_freed <= $max_size) {
      break;
    }

    $file_path = $directory . '/' . $record->cache_key . '.ogg';
    if (file_exists($file_path)) {
      @unlink($file_path);
    }

    \Drupal::database()->delete('local_tts_cache')
      ->condition('id', $record->id)
      ->execute();

    $bytes_freed += $record->file_size;
    $deleted++;
  }

  if ($deleted > 0) {
    \Drupal::logger('local_tts')->info('Deleted @count files (@size freed)', [
      '@count' => $deleted,
      '@size' => ByteSizeMarkup::create($bytes_freed),
    ]);
  }
}

/**
 * Remove disk files that have no corresponding database record.
 *
 * Catches orphans left by voice previews, failed generation, manual
 * database truncation, or race conditions during concurrent generation.
 * Rate-limited to run at most once every 6 hours.
 */
function _local_tts_cleanup_orphan_files() {
  $state = \Drupal::state();
  $last_run = $state->get('local_tts.orphan_cleanup_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_run < 21600) {
    return;
  }
  $state->set('local_tts.orphan_cleanup_last_run', \Drupal::time()->getRequestTime());

  $directory = _local_tts_get_audio_directory();
  if (!$directory) {
    return;
  }

  // Scan for both .ogg and .wav files to handle the format transition.
  $files = array_merge(
    glob($directory . '/*.ogg') ?: [],
    glob($directory . '/*.wav') ?: []
  );

  if (empty($files)) {
    return;
  }

  // Limit to 500 files per run to avoid timeout.
  $files = array_slice($files, 0, 500);

  // Build a set of all known cache keys from the database.
  $known_keys = \Drupal::database()->select('local_tts_cache', 'a')
    ->fields('a', ['cache_key'])
    ->execute()
    ->fetchCol();
  $known_keys = array_flip($known_keys);

  $deleted = 0;
  foreach ($files as $file_path) {
    $cache_key = pathinfo($file_path, PATHINFO_FILENAME);
    if (!isset($known_keys[$cache_key])) {
      @unlink($file_path);
      $deleted++;
    }
  }

  if ($deleted > 0) {
    \Drupal::logger('local_tts')->info('Deleted @count orphan audio files', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Check whether an entity bundle is allowed for TTS.
 *
 * @param string $entity_type
 *   Entity type ID.
 * @param string $bundle
 *   Bundle machine name.
 *
 * @return bool
 *   TRUE if allowed (or no whitelist is configured).
 */
function _local_tts_bundle_allowed($entity_type, $bundle) {
  $config = \Drupal::config('local_tts.settings');
  $allowed = $config->get('allowed_bundles') ?? [];
  if (empty($allowed)) {
    return TRUE;
  }
  $key = $entity_type . ':' . $bundle;
  return !empty($allowed[$key]);
}

/**
 * Get the real path to the audio cache directory.
 *
 * @return string|null
 *   Real filesystem path to the audio directory, or NULL if not accessible.
 */
function _local_tts_get_audio_directory() {
  $config = \Drupal::config('local_tts.settings');
  $audio_dir = $config->get('audio_directory') ?: 'public://local-tts';
  $file_system = \Drupal::service('file_system');
  $directory = $file_system->realpath($audio_dir);

  if (!$directory || !is_dir($directory)) {
    return NULL;
  }

  return $directory;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function local_tts_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Find Local TTS fields on this form.
  $has_tts_field = FALSE;
  $tts_field_key = NULL;

  foreach ($form as $key => $element) {
    // Skip non-array elements.
    if (!is_array($element)) {
      continue;
    }

    if (isset($element['#type']) && $element['#type'] === 'container') {
      if (isset($element['widget']['#field_name'])) {
        $field_name = $element['widget']['#field_name'];
        $form_object = $form_state->getFormObject();
        if (!($form_object instanceof EntityFormInterface)) {
          continue;
        }
        $field_definitions = \Drupal::service('entity_field.manager')
          ->getFieldDefinitions('node', $form_object->getEntity()->bundle());

        if (isset($field_definitions[$field_name]) && $field_definitions[$field_name]->getType() === 'local_tts_player') {
          $has_tts_field = TRUE;
          $tts_field_key = $key;
          break;
        }
      }
    }
  }

  if (!$has_tts_field) {
    return;
  }

  // Create Local TTS options group in sidebar.
  $form['local_tts_options'] = [
    '#type' => 'details',
    '#title' => t('Local Text-to-Speech'),
    '#group' => 'advanced',
    '#attributes' => [
      'class' => ['local-tts-form-options'],
    ],
    '#weight' => 96,
    '#optional' => TRUE,
  ];

  // Move the TTS field into the sidebar group.
  if (isset($tts_field_key)) {
    $form[$tts_field_key]['#group'] = 'local_tts_options';
  }
}
